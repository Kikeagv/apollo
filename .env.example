# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Identity email (APO-56)
# `simulated` records sent emails in-process; `resend` delivers real mail from
# noreply@usepraxia.com. The Resend API key lives only as a Coolify secret.
# Production fails to start if this is left as `simulated`.
IDENTITY_EMAIL_DELIVERY="simulated"
RESEND_API_KEY=""

# Cloudflare Turnstile (APO-56)
# `simulated` accepts a fixed test token for development and tests; `cloudflare`
# validates tokens against the Turnstile siteverify endpoint. Production fails
# to start if this is left as `simulated`.
TURNSTILE_VERIFICATION="simulated"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
